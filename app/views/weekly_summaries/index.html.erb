<% content_for :title, "AI Summaries" %>

<div class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">AI Coaching Summaries</h1>
      <p class="text-sm text-muted-foreground">Your weekly training reviews, generated by AI.</p>
    </div>

    <%= turbo_frame_tag "generate_summary" do %>
      <%= ui_button "Generate New Summary", href: weekly_summaries_path, data: { turbo_method: :post } do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/>
          <path d="M12 5v14"/>
        </svg>
        Generate New Summary
      <% end %>
    <% end %>
  </div>

  <%= turbo_frame_tag "weekly_summaries" do %>
    <% if notice.present? %>
      <%= ui_alert class: "mb-6" do %>
        <%= ui_alert_title "Hold tight" %>
        <%= ui_alert_description notice %>
      <% end %>
    <% end %>

    <% if @weekly_summaries.empty? %>
      <%= ui_card do %>
        <%= ui_card_header do %>
          <%= ui_card_title "No summaries yet" %>
          <%= ui_card_description "Generate your first AI coaching summary to see your weekly training analysis here." %>
        <% end %>
      <% end %>
    <% else %>
      <div class="grid gap-6 lg:grid-cols-2">
        <% @weekly_summaries.each do |summary| %>
          <%= ui_card do %>
            <%= ui_card_header do %>
              <div class="flex items-start justify-between gap-3">
                <div class="space-y-1.5">
                  <%= ui_card_title do %>
                    <%= summary.start_date.strftime("%b %d") %> – <%= summary.end_date.strftime("%b %d, %Y") %>
                  <% end %>
                  <%= ui_card_description "Generated #{summary.created_at.strftime("%b %d, %Y at %H:%M")}" %>
                </div>
              </div>
              <div class="flex flex-wrap gap-2 pt-1">
                <%= ui_badge "#{summary.metrics["total_activities"]} activities", variant: :outline %>
                <%= ui_badge format_distance(summary.metrics["total_distance_meters"]), variant: :outline %>
                <%= ui_badge format_duration(summary.metrics["total_moving_time_seconds"]), variant: :outline %>
              </div>
            <% end %>
            <%= ui_card_content class: "text-sm leading-relaxed [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5" do %>
              <%= simple_format(summary.content) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
