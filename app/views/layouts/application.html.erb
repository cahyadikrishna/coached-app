<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "AI Coach Assistant" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AI Coach Assistant">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-8">
          <%= link_to "AI Coach", root_path, class: "text-lg font-semibold tracking-tight" %>
          <% if current_user %>
            <div class="hidden items-center gap-5 text-sm font-medium text-muted-foreground sm:flex">
              <%= link_to "Activities", activities_path, class: "transition-colors hover:text-foreground" %>
              <%= link_to "AI Summaries", weekly_summaries_path, class: "transition-colors hover:text-foreground" %>
            </div>
          <% end %>
        </div>

        <% if current_user %>
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-2">
              <%= ui_avatar user: current_user, class: "h-8 w-8" %>
              <span class="hidden text-sm font-medium sm:inline"><%= current_user.name %></span>
            </div>
            <%= ui_button "Logout", href: logout_path, variant: :outline, size: :sm, data: { turbo_method: :delete } %>
          </div>
        <% end %>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <% if notice.present? %>
        <%= ui_alert class: "mb-6" do %>
          <%= ui_alert_title "Success" %>
          <%= ui_alert_description notice %>
        <% end %>
      <% end %>

      <% if alert.present? %>
        <%= ui_alert variant: :destructive, class: "mb-6" do %>
          <%= ui_alert_title "Error" %>
          <%= ui_alert_description alert %>
        <% end %>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
