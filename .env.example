# Strava OAuth
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Production database (Supabase PostgreSQL).
# NOTE: Do NOT set DATABASE_URL locally — it would override SQLite in development.
# Set it only in production, e.g. in a `.env.production` file or your deploy env:
#
#   DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:5432/postgres?sslmode=require
